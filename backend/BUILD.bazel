# carla_gt: the read-only CARLA ground-truth sidecar (REVAMP.md). LibCarla 0.9.15's headers want C++17.
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# Public: a consuming workspace (carla_ws RIG_VIZ) stages @carlaviz//backend:carla_gt.
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "gt_server",
    srcs = ["src/gt_server.cc"],
    hdrs = ["include/carlaviz/gt/gt_server.h"],
    includes = ["include"],
    copts = ["-std=c++17"],   # explicit: a consuming workspace (carla_ws) sets no -std
    deps = ["//third_party/websocketpp"],
)

cc_binary(
    name = "carla_gt",
    srcs = ["src/carla_gt.cc"],
    copts = ["-std=c++17", "-Wno-deprecated-declarations"],
    deps = [
        ":gt_server",
        "//third_party/carla:carla_client",
    ],
)
